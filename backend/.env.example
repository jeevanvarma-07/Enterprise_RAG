PROJECT_NAME="Enterprise RAG System"

# ── LLM provider keys ───────────────────────────────────────────────────────
# Add a key for any provider you want to use. All are free tiers. Leave the
# rest blank — only configured providers appear as usable in the app.
# (Phase 1 adds in-app encrypted key management; for dev they live here.)

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# NVIDIA NIM (free) — https://build.nvidia.com  (key looks like "nvapi-…")
NVIDIA_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Kimi / Moonshot — https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# z.ai (GLM) — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Optional: override any provider's base URL, e.g. to use a regional endpoint
# or to add an OpenAI-compatible provider not listed above (OpenCode Zen, Wafer,
# OpenRouter, …). Pattern: <PROVIDER>_BASE_URL
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Optional overrides (sane defaults if left unset) ────────────────────────
# Where uploads, the vector store, and settings.json are stored.
# Dev defaults to the backend/ folder; the packaged desktop app sets this.
# RAG_DATA_DIR=

# Backend bind host/port (defaults: 127.0.0.1:8000)
# RAG_HOST=127.0.0.1
# RAG_PORT=8000

# Comma-separated CORS origins (defaults cover Vite dev + Tauri).
# RAG_CORS_ORIGINS=http://localhost:5173,tauri://localhost
