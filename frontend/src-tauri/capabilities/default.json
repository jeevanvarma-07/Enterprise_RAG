{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Enterprise RAG desktop shell. The only privileged action is launching the bundled backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/rag-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
